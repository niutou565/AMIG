# 管理域名（多个用逗号分隔，上线后必须设置）
# 不设置时回退为主域名 /admin 可访问（仅首次部署过渡用）
ADMIN_DOMAIN=admin.example.com

# Cookie Secure 标志（HTTPS 部署下必须为 true，默认已启用）
# COOKIE_SECURE=true

# HSTS（可选，默认 max-age=31536000 且包含子域名）
# HSTS_MAX_AGE=31536000
# HSTS_INCLUDE_SUBDOMAINS=true

# 数据库路径（可选，默认 data/app.db）
# DATABASE_PATH=data/app.db

# 上传目录（可选，默认 uploads）
# UPLOADS_DIR=uploads

# ip-api.com 归属地查询超时和缓存时间（秒）
# IP_API_TIMEOUT=3
# IP_API_CACHE_TTL=300