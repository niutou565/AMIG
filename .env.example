# 管理域名默认值（多个用逗号分隔）。
# 仅在首次初始化或旧库尚未配置 admin_domain 时写入数据库一次；
# 之后请统一在后台「站点设置 → 管理域名」维护，修改本文件不会覆盖数据库配置。
ADMIN_DOMAIN=admin.example.com

# Cookie Secure 标志（HTTPS 部署下必须为 true，默认已启用）
# COOKIE_SECURE=true

# HSTS（可选，默认 max-age=31536000 且包含子域名）
# HSTS_MAX_AGE=31536000
# HSTS_INCLUDE_SUBDOMAINS=true

# 数据库路径（可选，默认 data/app.db）
# DATABASE_PATH=data/app.db

# 上传目录（可选，默认 uploads）
# UPLOADS_DIR=uploads

# 水印字体路径（可选，默认使用内置 Noto Sans SC，支持简体中文）
# WATERMARK_FONT_PATH=app/assets/fonts/NotoSansSC-Regular.otf

# ip-api.com 归属地查询超时和缓存时间（秒）
# IP_API_TIMEOUT=3
# IP_API_CACHE_TTL=300