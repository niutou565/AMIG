# 管理域名（多个用逗号分隔，支持 host:port 与 IPv6）。
# 仅在首次初始化或旧库尚未配置 admin_domain 时写入数据库一次；
# 之后统一在后台「站点设置 → 管理域名」维护，修改本文件不会覆盖数据库配置。
# 留空时后台仅允许本机回环地址访问（本地开发可保持留空）。
# ADMIN_DOMAIN=admin.example.com

# 启动参数（run.py 从 .env / 环境变量读取；一键启动脚本只读取 shell 环境变量 PORT/WORKERS，
# 不解析 .env）。生产环境必须只监听回环，由 Nginx 反向代理对外服务。
# HOST=127.0.0.1
# PORT=8000
# WORKERS=1

# Cookie Secure 标志：生产 HTTPS 必须保持 true；
# 仅本地 HTTP 调试可临时设为 false（启动时会打印安全警告）。
# COOKIE_SECURE=true

# HSTS（可选，默认 max-age=31536000 且包含子域名）
# HSTS_MAX_AGE=31536000
# HSTS_INCLUDE_SUBDOMAINS=true

# 数据库路径（可选，默认 data/app.db）
# DATABASE_PATH=data/app.db

# SQLite 稳定性（一般无需修改）
# 写锁等待上限（毫秒）；WAL 持久化级别 FULL/NORMAL/OFF；自动 checkpoint 页数
# DB_BUSY_TIMEOUT_MS=5000
# DB_SYNCHRONOUS=FULL
# DB_WAL_AUTOCHECKPOINT_PAGES=1000
# 慢查询日志阈值（毫秒，0 关闭）
# DB_SLOW_QUERY_MS=200
# 结构迁移前是否自动快照（快照失败则中止迁移）
# DB_BACKUP_BEFORE_MIGRATION=true

# 备份目录与保留份数（备份目录不得位于 uploads/private_uploads 或 Web 静态目录内）
# BACKUP_DIR=backups
# BACKUP_KEEP=7

# 公开上传目录（可选，默认 uploads）
# UPLOADS_DIR=uploads

# 私有上传目录（待审核/已拒绝图片），必须放在 Web 服务器不能直接静态访问的位置
# PRIVATE_UPLOADS_DIR=private_uploads

# 水印字体路径（可选，默认使用内置 Noto Sans SC，支持简体中文）
# WATERMARK_FONT_PATH=app/assets/fonts/NotoSansSC-Regular.otf

# 归属地查询超时和缓存时间（秒）；主数据源使用 HTTPS，无需额外配置
# IP_API_TIMEOUT=3
# IP_API_CACHE_TTL=300

# 可信反向代理（逗号分隔，仅支持 IP 或 CIDR，不支持主机名）。
# 只有来自这些地址的请求才会信任 X-Real-IP / X-Forwarded-Proto。
# 直接暴露公网时保持默认值（仅本机回环）。
# 禁止填写 0.0.0.0/0、::/0 等通配范围：会被拒绝并输出错误日志。
# 经 Docker/内部网桥转发时，填写实际的代理网段，例如 172.16.0.0/12。
# TRUSTED_PROXIES=127.0.0.1,::1

# 管理员 Session：绝对有效期（小时）与空闲超时（分钟）
# SESSION_TTL_HOURS=24
# SESSION_IDLE_MINUTES=120

# 登录失败限流：同一 IP 在窗口内的最大失败次数与窗口长度（分钟）
# 第二阶段的账户级全局锁定已取消，避免多 IP 攻击者锁死管理员
# LOGIN_IP_MAX_ATTEMPTS=5
# LOGIN_IP_WINDOW_MINUTES=15

# —— 以下两个变量为旧配置项（第二阶段的账户级锁定），现仅做兼容保留：
# 代码仍会读取它们，但不再参与登录拒绝判断；无需配置，留空即可
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCK_MINUTES=15