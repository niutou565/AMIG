# 站点密钥（请修改为随机字符串）
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars

# 管理域名（多个用逗号分隔，上线后必须设置）
# 不设置时回退为主域名 /admin 可访问（仅首次部署过渡用）
ADMIN_DOMAIN=admin.example.com

# 数据库路径（可选，默认 data/app.db）
# DATABASE_PATH=data/app.db

# 上传目录（可选，默认 uploads）
# UPLOADS_DIR=uploads

# ip2region 离线库路径（可选，默认 data/ip2region.xdb）
# IP2REGION_PATH=data/ip2region.xdb