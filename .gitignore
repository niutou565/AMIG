# ===== Python =====
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/

# ===== 本地环境配置（勿提交真实密钥）=====
.env

# ===== SQLite 数据库（data/ 下其余本地文件也不提交）=====
data/*
!data/.gitkeep

# ===== 本地备份（含完整数据，勿提交）=====
backups/*
!backups/.gitkeep

# ===== 上传的图片（用户内容，勿提交）=====
uploads/*
!uploads/.gitkeep
private_uploads/*
!private_uploads/.gitkeep

# ===== 日志 =====
*.log
logs/

# ===== 本地测试产物 =====
.screenshots/

# ===== 编辑器 / IDE =====
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# ===== 构建产物 =====
build/
dist/
*.egg
node_modules/
